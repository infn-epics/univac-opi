<?xml version='1.0' encoding='utf-8'?>
<display version="2.0.0">
  <name>Granville 307 VUG Launcher</name>
  <width>760</width>
  <height>430</height>
  <background_color>
    <color red="235" green="239" blue="244" />
  </background_color>
  <widget type="rectangle" version="2.0.0">
    <name>TitleBg</name>
    <width>760</width>
    <height>48</height>
    <line_width>0</line_width>
    <background_color>
      <color red="0" green="80" blue="160" />
    </background_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Title</name>
    <text>Granville 307 — VUG panels</text>
    <x>14</x>
    <y>8</y>
    <width>560</width>
    <height>30</height>
    <font>
      <font family="arial" style="BOLD" size="16.0" />
    </font>
    <foreground_color>
      <color red="255" green="255" blue="255" />
    </foreground_color>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Subtitle</name>
    <text>Old control configuration • read-only displays</text>
    <x>20</x>
    <y>62</y>
    <width>520</width>
    <height>25</height>
    <font>
      <font family="arial" style="ITALIC" size="11.0" />
    </font>
  </widget>
  <widget type="action_button" version="2.0.0">
    <name>Overview</name>
    <text>Open all-controller pressure overview</text>
    <x>20</x>
    <y>98</y>
    <width>720</width>
    <height>42</height>
    <font>
      <font family="arial" style="BOLD" size="12.0" />
    </font>
    <background_color>
      <color red="0" green="100" blue="200" />
    </background_color>
    <foreground_color>
      <color red="255" green="255" blue="255" />
    </foreground_color>
    <actions>
      <action type="open_display">
        <file>VUG-Overview.bob</file>
        <description>Open overview for the five configured VUG controllers</description>
      </action>
    </actions>
  </widget>
  <widget type="label" version="2.0.0">
    <name>ListHeading</name>
    <text>Individual controller detail</text>
    <x>20</x>
    <y>158</y>
    <width>400</width>
    <height>25</height>
    <font>
      <font family="arial" style="BOLD" size="12.0" />
    </font>
  </widget>
  <widget type="action_button" version="2.0.0">
    <name>VUGTR001</name>
    <text>VUGTR001</text>
    <x>20</x>
    <y>200</y>
    <width>170</width>
    <height>42</height>
    <actions>
      <action type="open_display">
        <file>VUG-Detail.bob</file>
        <macros>
          <P>DAFNE:VAC</P>
          <R>VUGTR001</R>
        </macros>
        <description>Read VUGTR001 pressures and status</description>
      </action>
    </actions>
  </widget>
  <widget type="action_button" version="2.0.0">
    <name>VUGTL001</name>
    <text>VUGTL001</text>
    <x>205</x>
    <y>200</y>
    <width>170</width>
    <height>42</height>
    <actions>
      <action type="open_display">
        <file>VUG-Detail.bob</file>
        <macros>
          <P>DAFNE:VAC</P>
          <R>VUGTL001</R>
        </macros>
        <description>Read VUGTL001 pressures and status</description>
      </action>
    </actions>
  </widget>
  <widget type="action_button" version="2.0.0">
    <name>VUGA3001</name>
    <text>VUGA3001</text>
    <x>390</x>
    <y>200</y>
    <width>170</width>
    <height>42</height>
    <actions>
      <action type="open_display">
        <file>VUG-Detail.bob</file>
        <macros>
          <P>DAFNE:VAC</P>
          <R>VUGA3001</R>
        </macros>
        <description>Read VUGA3001 pressures and status</description>
      </action>
    </actions>
  </widget>
  <widget type="action_button" version="2.0.0">
    <name>VUGA2001</name>
    <text>VUGA2001</text>
    <x>20</x>
    <y>260</y>
    <width>170</width>
    <height>42</height>
    <actions>
      <action type="open_display">
        <file>VUG-Detail.bob</file>
        <macros>
          <P>DAFNE:VAC</P>
          <R>VUGA2001</R>
        </macros>
        <description>Read VUGA2001 pressures and status</description>
      </action>
    </actions>
  </widget>
  <widget type="action_button" version="2.0.0">
    <name>VUGA1001</name>
    <text>VUGA1001</text>
    <x>205</x>
    <y>260</y>
    <width>170</width>
    <height>42</height>
    <actions>
      <action type="open_display">
        <file>VUG-Detail.bob</file>
        <macros>
          <P>DAFNE:VAC</P>
          <R>VUGA1001</R>
        </macros>
        <description>Read VUGA1001 pressures and status</description>
      </action>
    </actions>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Info</name>
    <text>Displays read the pressure, validity, degas, and relay status PVs. They do not expose write controls.</text>
    <x>20</x>
    <y>335</y>
    <width>720</width>
    <height>45</height>
    <font>
      <font family="arial" style="ITALIC" size="10.0" />
    </font>
    <foreground_color>
      <color red="70" green="70" blue="70" />
    </foreground_color>
  </widget>
</display>